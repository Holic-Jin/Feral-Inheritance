<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet policy for Feral Inheritance (csharp-tools-review.md, approved 2026-10-26).
  - nuget.org is the only package source (<clear/> drops every inherited source).
  - packageSourceMapping: each approved package ID is mapped to nuget.org explicitly;
    any other package ID has no source and cannot be restored.
  - trustedSigners: nuget.org repository signature, restricted to the owners
    krafs (Krafs.Rimworld.Ref), pardeike (Lib.Harmony) and Microsoft
    (Microsoft.NETFramework.ReferenceAssemblies*). Fingerprints were read from the
    signatures of the locked packages themselves:
      1F4B311D... = nuget.org repository cert used for Krafs.Rimworld.Ref and Lib.Harmony
      5A2901D6... = nuget.org repository cert used for Microsoft.NETFramework.ReferenceAssemblies 1.0.3 (2022)
  - signatureValidationMode is left at the default (accept): the review does not ask for
    "require". trustedSigners is still enforced for signed packages in accept mode
    (verified: a wrong owner list makes restore fail with NU3034 "signed but not by a
    trusted signer"). All four locked packages are signed.
  Model-generated diffs may never modify this file (tools/model_gateway.py deny list).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="Krafs.Rimworld.Ref" />
      <package pattern="Lib.Harmony" />
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies" />
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies.net472" />
    </packageSource>
  </packageSourceMapping>
  <trustedSigners>
    <clear />
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>krafs;pardeike;Microsoft</owners>
    </repository>
  </trustedSigners>
</configuration>
